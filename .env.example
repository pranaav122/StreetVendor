# Development only. Copy to .env and replace this password before starting.
POSTGRES_DB=mystreetvendor
POSTGRES_USER=mystreetvendor
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Host Python connects through the Windows published port.
# Compose overrides host/port inside api to db:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=3
API_PORT=8000
# Independent signing secret; never reuse the database password.
JWT_SECRET=replace-with-a-random-signing-key-at-least-32-characters
# Local Mailpit inbox only. Production requires a real sender and encrypted SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=false
PUBLIC_CUSTOMER_URL=http://127.0.0.1:8081
PUBLIC_VENDOR_URL=http://127.0.0.1:8082
# Explicitly enable the bounded single-process expiry/retention loop for host Python.
JOBS_ENABLED=true
