# Copy to a PRIVATE ignored file. Replace every placeholder before deployment.
# Never reuse local .env credentials. Docker operators can read container envs.
POSTGRES_DB=mystreetvendor
BOOTSTRAP_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
MIGRATION_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
RUNTIME_PASSWORD=REPLACE_WITH_ANOTHER_INDEPENDENT_SECRET
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS_INDEPENDENT_OF_DATABASE_PASSWORDS
API_DOMAIN=api.REPLACE_WITH_YOUR_DOMAIN
ADMIN_DOMAIN=admin.REPLACE_WITH_YOUR_DOMAIN
PUBLIC_CUSTOMER_URL=https://REPLACE_WITH_CUSTOMER_RECOVERY_ORIGIN
PUBLIC_VENDOR_URL=https://REPLACE_WITH_PARTNER_RECOVERY_ORIGIN
# The owner must approve the real pilot boundary; no city is silently selected.
SERVICE_AREA_GEOJSON=REPLACE_WITH_APPROVED_GEOJSON_POLYGON
SMTP_HOST=REPLACE_WITH_TLS_SMTP_HOST
SMTP_PORT=587
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER_ADDRESS
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional until separate Expo/EAS projects and real device delivery are verified.
EXPO_ACCESS_TOKEN=
EXPO_CUSTOMER_PROJECT_ID=
EXPO_VENDOR_PROJECT_ID=
